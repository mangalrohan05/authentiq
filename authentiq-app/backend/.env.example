# Copy to .env and adjust as needed

DATABASE_URL=mongodb://localhost:27017
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenCLIP — use openai fallback if LAION download fails (HF 403 / proxy)
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
OPENCLIP_PRETRAINED_FALLBACK=openai

# YOLO region proposals (enhances OpenCLIP; does not replace it)
AUTHENTIQ_YOLO_ENABLED=true
AUTHENTIQ_YOLO_MODEL=yolov8n.pt
AUTHENTIQ_YOLO_CONF=0.25
AUTHENTIQ_YOLO_DEBUG=false

# Hybrid scoring weights (slot: global vs regional; categories: logo, label, …)
AUTHENTIQ_SLOT_BLEND_GLOBAL=0.55
AUTHENTIQ_SLOT_BLEND_REGIONAL=0.45
AUTHENTIQ_IDENTITY_BOOST=true
AUTHENTIQ_IDENTITY_BOOST_MIN_GLOBAL=0.97
AUTHENTIQ_IDENTITY_BOOST_TARGET=0.96

# v4 pipeline: ORB homography + ROI SSIM/MSE (angle/size tolerant)
AUTHENTIQ_ALIGNMENT_ENABLED=true
AUTHENTIQ_ORB_FEATURES=2500
AUTHENTIQ_ALIGN_MIN_MATCHES=12

# ═══════════════════════════════════════════════════════════════════════════
# VLM authentication (v7) — Qwen2.5-VL is the PRIMARY adjudicator. See VLM_SETUP.md
# The old ±0.35 "boost/penalty nudge" (AUTHENTIQ_VLM_BOOST/PENALTY/TRIGGER_*) is
# REMOVED. The VLM now decides authenticity from full metadata + all reference
# views, and a single critical defect vetoes the score.
# ═══════════════════════════════════════════════════════════════════════════
AUTHENTIQ_VLM_ENABLED=true
# OpenAI-compatible endpoint of your self-hosted Qwen2.5-VL server:
#   vLLM   -> http://localhost:8000/v1/chat/completions
#   Ollama -> http://localhost:11434/v1/chat/completions
AUTHENTIQ_VLM_API_URL=http://localhost:11434/v1/chat/completions
AUTHENTIQ_VLM_API_KEY=
AUTHENTIQ_VLM_MODEL=qwen2.5vl:7b
AUTHENTIQ_VLM_TIMEOUT=90
AUTHENTIQ_VLM_MAX_RETRIES=2
AUTHENTIQ_VLM_MAX_TOKENS=1536
# Image payload — your server must allow this many images per prompt.
# vLLM: start with  --limit-mm-per-prompt image=12
AUTHENTIQ_VLM_MAX_IMAGES=12
AUTHENTIQ_VLM_MAX_REFS_PER_VIEW=1
AUTHENTIQ_VLM_IMAGE_MAX_DIM=1024
# Fail policy when the VLM is unreachable: closed=needs_review (recommended),
# open=provisional CLIP result capped below 'authentic' (dev only).
AUTHENTIQ_VLM_FAIL_MODE=closed
AUTHENTIQ_VLM_DEV_MOCK=false
# Decision tuning (the veto that catches MINOR counterfeits):
AUTHENTIQ_VLM_CRITICAL_VETO_CAP=0.30
AUTHENTIQ_VLM_COUNTERFEIT_CAP=0.30
AUTHENTIQ_VLM_MAJOR_PENALTY=0.18
AUTHENTIQ_VLM_MINOR_PENALTY=0.06
# CLIP gross-mismatch pre-filter (below this best-similarity, skip VLM -> suspicious)
AUTHENTIQ_CLIP_GROSS_MISMATCH_MIN=0.35

AUTHENTIQ_ALIGN_MIN_INLIERS=10
AUTHENTIQ_ALIGN_MAX_REPROJ_ERR=5.0

# v5 multi-stage pipeline: Dimension + Feature Matching + RANSAC
AUTHENTIQ_DIMENSION_THRESHOLD=0.90
AUTHENTIQ_FEATURE_METHOD=auto  # auto, superpoint, or orb
AUTHENTIQ_FEATURE_MATCH_THRESHOLD=0.75
AUTHENTIQ_RANSAC_THRESHOLD=0.70

# ── DEPRECATED in v7 (no longer affect the authenticity decision) ────────────
# The weighted-average ensemble, the CLIP score floor, and the ROI fraud penalty
# were replaced by the VLM-primary decision above. These are kept only so old
# .env files don't break; they have no effect on scoring now.
# AUTHENTIQ_ENS_GLOBAL / _OCR / _RANSAC / _DIMENSION / _FEATURE_MATCH ...  (ignored)
# AUTHENTIQ_FRAUD_GLOBAL_HIGH / _ROI_LOW / _PENALTY_MAX                    (ignored)
# AUTHENTIQ_GLOBAL_SCORE_FLOOR                                            (ignored)
# AUTHENTIQ_IDENTITY_BOOST*                                              (ignored)

# Vendor password reset emails (dev: links printed to server console)
FRONTEND_BASE_URL=http://localhost:3000
# SMTP_ENABLED=true
